APP_SECRET=secret
JWT_SECRET=jwtSecret
NODE_ENV=compose

# Optional for local npm mode when host MySQL is not on 3306:
# NODE_CONFIG={"db":{"host":"localhost","port":3308}}

# Database container variables
MYSQL_ALLOW_EMPTY_PASSWORD=1
MYSQL_DATABASE=sunnydb
MYSQL_TCP_PORT=3306

# LocalStack variables
SERVICES=s3
DEBUG=1
